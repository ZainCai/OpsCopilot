# OpsCopilot 环境变量样例（优化方案 #2 配置收敛后重写）。
# 复制为 .env 后按需修改（.env 已在 .gitignore；真实凭证绝不入库——架构安全要求）。
#
# 统一解析策略（唯一装载通道 internal/config，启动期生效）：
#   - 缺失（未设置/空白）→ 取本文件标注的默认值；
#   - 非法值 → **启动失败**，一次性列出全部配置错误（聚合报错，修一轮就够）；
#   - on/off 开关只认 on|off（大小写不敏感），"1/true/yes" 一律拒绝；
#   - 例外：双 Redis 地址必填（物理隔离 v1.2 C2 不放松，缺失也报错）。
# 完整清单表（含消费方与解析细节）见 docs/配置清单-OpsEnv.md。

# ─── 双 Redis（ADR-004，必填）─────────────────────────────────────────
# alert：持久化实例（告警流+会话状态，AOF everysec/noeviction）；cache：可逐出实例。
# 两个都必须显式设置且不得指向同一实例（localhost 与 127.0.0.1 视为同一个）。
REDIS_ALERT_ADDR=127.0.0.1:6380
REDIS_CACHE_ADDR=127.0.0.1:6381

# ─── 租户 ────────────────────────────────────────────────────────────
# 租户 ID（事件/簇/审计/队列/渠道/变更库共用）；默认 default。
# 评估/演示建议独立租户，避免与旧实例互污时间窗。
# OPS_TENANT=default

# ─── 数据库（TimescaleDB 真相源）─────────────────────────────────────
# ⚠️ 默认口令仅限本地开发；生产部署必须覆盖为强口令并启用 TLS
# （生产架构见 ADR-006：Patroni 主备 + 内网隔离，本机 compose 仅供联调）。
# DB_PASSWORD 供 compose 里的 timescaledb 容器建库用（应用不读取它）。
DB_PASSWORD=opscopilot
# 应用读取的连接串；未设置 → 事件/审计/变更库降级内存、导入队列不启用（骨架仍可服务）。
OPS_DB_DSN=postgres://opscopilot:opscopilot@localhost:5432/opscopilot?sslmode=disable
# 共享连接池上限（D7：事件 Store+导入队列+审计+变更库共用）；默认 16，须为正整数
# （非法值原为"警告后取 pgx 默认"——现启动失败）。
# OPS_DB_MAX_CONNS=16

# ─── 安全门禁（D1/D2 决策）───────────────────────────────────────────
# HTTP 监听地址；默认 127.0.0.1:8080（S1 只绑回环；容器内需 0.0.0.0:8080，见 compose）
# OPS_LISTEN_ADDR=127.0.0.1:8080
# 变更/写端点共享密钥（请求头 X-OpsCopilot-Token）；为空 = 无鉴权
# （非回环暴露会被下面的门禁拦下）。
# OPS_WEBHOOK_TOKEN=
# 逃生门：非回环监听且无密钥时默认**启动失败**；仅限本机联调才可设 on（严禁生产）
# OPS_ALLOW_UNAUTHENTICATED=off
# 跨源放行白名单：默认不设 = 仅同源；须形如 scheme://host 或 null；"*" 直接启动失败
# OPS_CORS_ORIGIN=

# ─── 连接器（按需注册；全不配则 Host 空转，webhook/拓扑照常服务）──────
# Prometheus 基址（设置即注册；告警拉取侧同源复用这两项，不再有第二套 env）
# OPS_PROM_URL=http://localhost:9090
# 可选 Bearer Token；env 裸 Token 会包装成只读凭证走只读闸门（ADR-002）
# OPS_PROM_TOKEN=
# Azure（可选，仅发现）：订阅 ID 与 ARM 令牌**同时**设置才注册；令牌绝不日志化
# OPS_AZURE_SUBSCRIPTION_ID=
# OPS_AZURE_TOKEN=
# 采集轮询周期（新 env，取代 connector/host 侧写死的 30s）；非法值启动失败
# OPS_CONNECTOR_INTERVAL=30s
# 单连接器单轮操作超时（C3 第二道防线；新 env，取代装配里写死的 30s）
# OPS_CONNECTOR_TIMEOUT=30s

# ─── 降噪（W4-1.4 / W9-1 ADR-011）────────────────────────────────────
# on/off：off 整体关闭（连影子判决都不产生，回到只计数行为）；默认 on
# OPS_NOISE_SHADOW=on
# 去重/聚类时间窗（Go duration，须为正）；默认 10m；非法值启动失败
# OPS_NOISE_WINDOW=10m
# shadow（默认，只标注不拦截）| enforce（真拦截 + 放行通知，需 DB 落计数；
# 建议 shadow 双跑 1 周再转正；回退 = 改回 shadow 重启）；非法值启动失败
# OPS_NOISE_MODE=shadow
# L2 事件相似度时间邻近窗口（新 env，取代 rest_gateway 写死的 30m）
# OPS_DEDUP_WINDOW=30m
# 判决异步落库队列（优化方案 #8，队满丢弃取向）：ProcessAlerts 生成判决后
# 投递缓冲队列即返回，单 writer 攒批落库（Redis 镜像 + PG 真相源出口不变）
# ——慢 DB 不占采集节拍。队列永不阻塞、不回退同步写：队满/停机丢持久化、
# 不丢通知（判决照常走内存 Gate）；丢弃计入 counter 并打 ERROR 日志：
# opscopilot_noise_sink_drops_total{store}
# ⚠️ PG 判决流在极端洪峰下可缺条目；Redis/PG 镜像与内存态非强一致。
# 队列缓冲判决条数；默认 4096（≈20 个满批；水位 gauge
# opscopilot_noise_sink_queue 观察）
# OPS_NOISE_SINK_QUEUE=4096
# writer 攒批阈值（攒满即刷）；默认 200
# OPS_NOISE_SINK_BATCH=200
# writer 定时刷批周期（不满一批的最长滞留）；默认 2s
# OPS_NOISE_SINK_FLUSH=2s
# 停机 drain 上限超时（超时残量计丢弃后放行停机）；默认 5s
# OPS_NOISE_SINK_DRAIN=5s

# ─── 拉取链路（W11，链路 A 拉取侧）───────────────────────────────────
# on/off：默认 off（避免与 push 并存时重复导入）；on 需 OPS_PROM_URL 且需 DB 队列
# OPS_PULL_ALERTS=off
# 轮询周期；默认 30s。非法值原为"警告后取默认"——现启动失败
# OPS_PULL_INTERVAL=30s

# ─── ingest 队列（W9 链路 A：入队/消费/风暴限流）─────────────────────
# 自动建单开关 on/off：默认 off（影子期——消息只入队不建单，on 后回放建单）
# OPS_INCIDENT_AUTOCREATE=off
# 消费轮询周期；默认 5s
# OPS_INGEST_INTERVAL=5s
# 单轮批量；默认 20（正整数）
# OPS_INGEST_BATCH=20
# 建单风暴限流（R1）：窗口内新建上限 / 窗口长度；默认 50 / 5m，
# 超限折叠进"群体事件"聚合单（可回放）。原为 ingest_queue.go 写死的
# 魔法数字（#10 进 schema），默认值不变。
# OPS_INGEST_RATE_LIMIT=50
# OPS_INGEST_RATE_WINDOW=5m
# 批消费超时 = 批量 × 本值（第七轮 M-2 的线性放大口径；原写死 15s/条）
# OPS_INGEST_BATCH_TIMEOUT_PER_ITEM=15s
# 告警载荷字节上限：入站 AM webhook 请求体与拉取响应**共用这一处定义**
# （原两处重复的 4MiB 已合并为单一定义）；默认 4194304（=4MiB）
# OPS_INGEST_ALERT_BODY_LIMIT=4194304
# 认领租约时长（#11 水平扩展 / ADR-012，migration 000016）：多实例并发消费
# 同一张队列时，认领的行在租约内归本实例（locked_by/locked_until），过期自动
# 可被其他实例重领（at-least-once，下游建单幂等不重复）。取值应 ≥ 单批最坏
# 处理时长；默认 2m；非法值启动失败
# OPS_INGEST_LEASE_DURATION=2m

# ─── leader 选举与后台循环门禁（#11 水平扩展 / ADR-012）───────────────
# on/off：默认 on——有 OPS_DB_DSN 即用 PG 会话级 advisory lock（固定键
# 0x4F43504C "OCPL"）选主，**leader 才跑** Host 采集/拓扑判决链路/告警拉取
# (OPS_PULL_ALERTS)/Retention 归档；**所有实例常驻** webhook 入队+IngestWorker
# 消费、REST/SSE、通知、escalation 升级扫描（PG 台账互斥）、ChangePruner。
# 无 DB 或 off → 恒为 leader（单实例降级路径，行为与选举引入前完全一致）。
# 本实例 leader 态看 /metrics 的 opscopilot_is_leader（=1 即 owner）。
# OPS_LEADER_ELECTION=on
# 竞选节拍 = 持锁复检（连接探针）节拍 = failover 接管上界；默认 5s；非法值启动失败
# OPS_LEADER_RETRY_INTERVAL=5s

# ─── 通知与值班升级（W9-3）───────────────────────────────────────────
# 渠道配置存在 DB（POST /api/v1/notify/channels 管理），env 只有升级调度。
# on/off：默认 off。on 时扫 state=open 且创建超 AFTER 的事件，升级一次
# （台账幂等只发一次；无 DB 时台账退化内存——重启即丢、仅单实例正确）
# OPS_ESCALATION=off
# 未 ack 触发升级的等待时长；默认 15m。非法值原为"警告后取默认"——现启动失败
# OPS_ESCALATION_AFTER=15m
# 扫描周期；默认 60s（同上，非法值启动失败）
# OPS_ESCALATION_INTERVAL=60s

# ─── 保留与归档（D8 决策 C）──────────────────────────────────────────
# 工单 resolved 满 N 天归档 incident_archive（事件+簇+审计打包 JSONB，不丢上下文，
# 审计长留）；接受 duration（2160h）/天数（90d）/off；默认 90d；非法值启动失败
# OPS_INCIDENT_RETENTION=90d

# ─── 拓扑与变更（W6-0 / W9-5 / 优化方案 #4）─────────────────────────
# 静态拓扑边（评估环境用）："n1->n2,n2->n3"；短名自动补 prometheus://nodes/ 前缀；
# 段格式非法启动失败
# OPS_TOPOLOGY_EDGES=
# 变更事件库保留窗（接受 duration（168h）/天数（7d）/off；默认 7d）。
# off = 不清理（全量保留且全量回放）；非法值启动失败。
# 每轮清理打容量日志（size/pruned），超 10 万条另打 WARNING。
# OPS_CHANGE_RETENTION=7d
# 清理周期；默认 1h；非法值启动失败
# OPS_CHANGE_PRUNE_INTERVAL=1h

# ─── 按需根因分析 RCA（优化方案 #12 / ADR-014）───────────────────────
# on/off：默认 on——只读按需分析（GET /api/v1/incidents/{id}/rca），无副
# 作用面；off 时端点显式 503。非法值启动失败
# OPS_RCA=on
# 自动触发（二期池波二 #4）：on 时 critical 事件被值班升级成功催办后，异步
# 跑一次该事件的 RCA 并落审计（action='rca'，actor="auto"）；默认 off 保持
# "只做按需"现状。须 OPS_RCA=on（否则启动失败）；触发点还依赖
# OPS_ESCALATION=on（无升级则无触发时刻，装配打 WARNING 不生效）。防风暴：
# 同一 incident 只自动触发一次（内存 + 审计回读双保险，重启不重跑）；分析走
# 独立 goroutine + 有界队列（队满丢弃计数
# opscopilot_rca_autotrigger_dropped_total，绝不阻塞升级扫描）。非法值启动失败
# OPS_RCA_AUTO=off
# 单次分析超时（取证 + 六步全链路；超时 REST 504）；默认 10s；非法值启动失败
# OPS_RCA_TIMEOUT=10s
# 证据窗：T0（事件创建时刻）往前多久内的变更算嫌疑（"告警前 30 分钟"
# 经典取证口径，对齐 change.go）；默认 30m；非法值启动失败
# OPS_RCA_WINDOW=30m
# 故障域邻域取证跳数（1..10，上限与 GetTopology depth 同源）；默认 2；
# 非正整数启动失败
# OPS_RCA_DEPTH=2
# findings 截断上限（二期池波二 #6）：报告 findings 超此数时按"置信度优先
# + 同档时序"截断，被裁条数以 findings_truncated 记入报告与审计；默认 200
# （转正前 rest_rca.go 硬编码上限的可配置化，默认零漂移）；非正整数启动失败。
# REST GET /api/v1/incidents/{id}/rca 默认回显截断版（truncated=true），加
# ?all=1（仍在 Token 门禁内）一次性取未截断全量——同步报告在内存里现成，
# 游标分页是过度设计。conclude 步送给 llm-gateway 的 prompt 证据行同守此上限
# （llmgw 输入侧预算防线，响应侧另有 1MiB 上限）。
# OPS_RCA_MAX_FINDINGS=200

# ─── RCA 复盘会话 sessionstore 接线（二期池 #7；设计文档拍板定案）────────
# on/off：默认 **off**——off 时不构造会话热态 Redis 客户端、会话端点显式 503，
# 全链路零行为变化。on 须 OPS_RCA=on（会话 prompt 必携带 RCA findings，
# 编排器 off 时不存在 → 启动失败，同款于 OPS_RCA_AUTO 的约束）。
# 语义（五条拍板）：Redis（告警实例，P1-1 守卫）只做 2h TTL 热态缓冲，真相在
# PG（migration 000018 rca_session/rca_session_turn），TTL 蒸发后 GET 懒恢复
# 重建回填；轮次正文不算审计证据（audit 哈希链不动，llm_meta 只存哈希/长度）；
# 会话 incident 级共享（键 = tenant+incident_id，participants 存表）；端点挂
# GET/POST /api/v1/incidents/{id}/rca/session（GET 读会话、POST 追加轮次）；
# 鉴权沿用单 Token 闸门 + 每轮 created_by 留身份钩子。assistant 轮只经 llmgw
# 单出口产出：LLM 未配置/失败 → fail-open pending（宁 pending 不假答），降级面
# 看指标 opscopilot_session_llm_requests_total{outcome} / _duration_seconds。
# 超时/正文上限不新增键：复用 OPS_LLM_TIMEOUT / OPS_RCA_TIMEOUT / 建单体上限。
# OPS_SESSION=off

# ─── LLM 网关 llm-gateway（二期池波二 #3 / ADR-015；OPS_LLM_* 组）──────
# 通用 OpenAI-compatible chat 出口（vLLM/Ollama/国产网关均可），不绑厂商。
# 消费方 = RCA conclude 步（GET /rca 的 LLM 结论）+ RCA 复盘会话 assistant 轮
# （OPS_SESSION=on 时，二期池 #7）。
# **默认禁用**：OPS_LLM_ENDPOINT 留空/不设 → conclude 维持 pending、
# conclusion=null，行为与 ADR-014 逐字节一致（/rca 不因此报错）。
# 出口纪律（ADR-003/015）：LLM 协议出口唯一（internal/llmgw，不持
# http.Client）；物理发送唯一（internal/transport HTTPClient）——业务模块
# 不得直连模型。
# base URL（到 /v1 一级即可；补全端点路径由 llmgw 拼接）；非法 URL → 启动失败
# OPS_LLM_ENDPOINT=
# Bearer 密钥（Secret）：**绝不入库、绝不进日志/指标/审计**（.env 已被
# .gitignore 保护）。仅容忍行尾空白（防手抄带回车 401）；其余原样承接
# OPS_LLM_API_KEY=
# 模型名：配置了 ENDPOINT 即**必填**（无厂商默认模型名；缺失 → 启动失败）
# OPS_LLM_MODEL=
# 单次 chat 请求超时；默认 8s；**超时预算纪律**：LLM 超时 + 2s 硬预留
# （前四步取证 IO + 规则计算）必须塞进 OPS_RCA_TIMEOUT——默认 8s+2s=10s
# 恰好压线；破坏预算的组合（如 LLM 9s 对 RCA 10s）启动即拒。非法值启动失败
# OPS_LLM_TIMEOUT=8s
# 补全 max_tokens 上限；默认 1024（结论千字级顶天）；非正整数启动失败
# OPS_LLM_MAX_TOKENS=1024
# 失败语义（fail-open）：超时/非 200/坏 JSON/空结论 → 该请求 conclude 步
# 回退 pending（报告退回证据链形态，/rca 绝不因 LLM 故障 5xx）；降级面看
# 指标 opscopilot_llm_requests_total{outcome=ok|timeout|error} 与
# opscopilot_llm_duration_seconds。日志只记模型/长度/SHA-256/耗时（脱敏）。

# ─── 内存有界化（优化方案 #6；OPS_MEMLIMIT_* 组）────────────────────
# 给无上限内存结构设"最后一道保险"：上限按开发/演示规模不可能触发设定，
# 正常行为与不设限完全一致；触限按最久未活跃淘汰并记 slog WARN +
# /metrics 指标（opscopilot_mem_entries{store} / opscopilot_mem_evictions_total{store}）。
# 全部须为正整数（比例除外），非法值启动失败（聚合报错）。
# 告警水位：规模达上限×比例先打 WARN（不等淘汰）；须落在 (0,1]，默认 0.8
# OPS_MEMLIMIT_WARN_RATIO=0.8
# 拓扑图节点上限（过度淘汰伤降噪故障域/RCA as_of 取证，默认保守 10 万）
# OPS_MEMLIMIT_TOPOLOGY_NODES=100000
# 拓扑图边上限（端点必为图内节点，默认取节点×4）
# OPS_MEMLIMIT_TOPOLOGY_EDGES=400000
# 事件内存兜底 Store 上限（仅 OPS_DB_DSN 缺席时生效；PG 在位不触发）
# OPS_MEMLIMIT_INCIDENTS=50000
# 值班升级台账内存兜底上限（仅无 DB 降级路径）
# OPS_MEMLIMIT_ESCALATION_LEDGER=100000
# 去重指纹表上限（窗口清扫之外的唯一指纹基数洪峰保险）
# OPS_MEMLIMIT_NOISE_DEDUP=200000
# 内存簇上限（活跃+历史总量；历史区 resolved 最先出局，可自存储侧 Restore 重建）
# OPS_MEMLIMIT_NOISE_CLUSTERS=50000
# 簇落库签名缓存上限（孤儿键超限 GC）
# OPS_MEMLIMIT_NOISE_SIGCACHE=50000
# 审计内存兜底上限（仅无 DB 降级路径；触限丢最旧）
# OPS_MEMLIMIT_AUDIT=50000

# ─── 仅测试门控（应用不读取，装载器也不认识它）───────────────────────
# PG 相关集成测试在此 DSN 设置时才运行，否则按仓库惯例 skip。
# 须指向独立测试库（勿复用开发库——数据累积会红 incident 契约用例）：
# 用 bash scripts/reset_test_pg.sh [--wipe] 建库并应用迁移；详见 docs/配置清单-OpsEnv.md 附录 B。
# OPS_TEST_PG_DSN=postgres://opscopilot:opscopilot@localhost:5432/opscopilot_test?sslmode=disable

# Go 模块代理（国内环境必须，proxy.golang.org 不通）
GOPROXY=https://goproxy.cn,direct
