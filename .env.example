# 本地开发环境变量样例（复制为 .env 后按需修改，.env 已在 .gitignore 中）
# 注意：真实凭证绝不入库（架构安全要求）

# 数据库（自建 TimescaleDB 社区版 TSL）
# ⚠️ 默认口令仅限本地开发；生产部署必须覆盖为强口令并启用 TLS
# （生产架构见 ADR-006：Patroni 主备 + 内网隔离，本机 compose 仅供联调）
DB_PASSWORD=opscopilot
DB_DSN=postgres://opscopilot:opscopilot@localhost:5432/opscopilot?sslmode=disable

# 变更 webhook 共享密钥（S1）：为空 = 端点无鉴权（进程启动会打警告）。
# 非回环暴露前必须设置；调用方请求头 X-OpsCopilot-Token 需与之一致
# OPS_WEBHOOK_TOKEN=
# HTTP 监听地址（默认 127.0.0.1:8080，容器内需 0.0.0.0:8080，见 compose）
# OPS_LISTEN_ADDR=

# Redis 双实例（ADR-004）
# alert：持久化，承载告警流 + 会话状态；cache：可逐出，仅放可重建数据
REDIS_ALERT_ADDR=127.0.0.1:6380
REDIS_CACHE_ADDR=127.0.0.1:6381

# Go 模块代理（国内环境必须，proxy.golang.org 不通）
GOPROXY=https://goproxy.cn,direct
