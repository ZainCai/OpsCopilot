# 本地开发环境变量样例（复制为 .env 后按需修改，.env 已在 .gitignore 中）
# 注意：真实凭证绝不入库（架构安全要求）

# 数据库（自建 TimescaleDB 社区版 TSL）
# ⚠️ 默认口令仅限本地开发；生产部署必须覆盖为强口令并启用 TLS
# （生产架构见 ADR-006：Patroni 主备 + 内网隔离，本机 compose 仅供联调）
# DB_PASSWORD 供 compose 里的 timescaledb 容器建库用；
# OPS_DB_DSN 才是**应用**读取的连接串（未设置 → 事件降级内存、导入队列不启用）。
DB_PASSWORD=opscopilot
OPS_DB_DSN=postgres://opscopilot:opscopilot@localhost:5432/opscopilot?sslmode=disable

# 变更 webhook 共享密钥（S1）：为空 = 端点无鉴权（进程启动会打警告）。
# 非回环暴露前必须设置；调用方请求头 X-OpsCopilot-Token 需与之一致
# OPS_WEBHOOK_TOKEN=
# HTTP 监听地址（默认 127.0.0.1:8080，容器内需 0.0.0.0:8080，见 compose）
# OPS_LISTEN_ADDR=
# D1 安全门禁：非回环监听且未设置 OPS_WEBHOOK_TOKEN 时**启动失败**；
# 仅限本机联调时才允许显式豁免（严禁用于生产）
# OPS_ALLOW_UNAUTHENTICATED=off
# D2 跨源放行白名单：默认**不设置** = 仅同源可读（推荐）。
# 需要"静态打开 console.html + ?api= 指向服务"时才配置，如
# OPS_CORS_ORIGIN=https://ops.example.com   （或 null）
# OPS_CORS_ORIGIN=

# 数据库连接池上限（D7）：事件 Store + 导入队列 + 审计三方共用，
# pgx 默认 max(4,NumCPU) 偏小，并发下易耗尽
# OPS_DB_MAX_CONNS=16
# D8 事件保留策略（决策 C）：resolved 满 N 天**归档**到 incident_archive
# （事件本体 + 关联簇 + 审计轨迹打包成 JSONB，不丢上下文）；审计长留。
# 接受 Go duration（2160h）或天数（90d）；off 关闭；默认 90d
# OPS_INCIDENT_RETENTION=90d

# Redis 双实例（ADR-004）
# alert：持久化，承载告警流 + 会话状态；cache：可逐出，仅放可重建数据
REDIS_ALERT_ADDR=127.0.0.1:6380
REDIS_CACHE_ADDR=127.0.0.1:6381

# 连接器（W4-1.1 起按需装配；不设置则 Host 空转，webhook/拓扑照常可用）
# Prometheus 基址（设置即注册 prometheus 连接器，告警/指标/目标只读采集）
# OPS_PROM_URL=http://localhost:9090
# 可选 Bearer Token；env 裸 Token 会包装成只读凭证走只读闸门（ADR-002）
# OPS_PROM_TOKEN=
# Azure（可选，仅发现）：订阅 ID 与 ARM 令牌同时设置才注册
# OPS_AZURE_SUBSCRIPTION_ID=
# OPS_AZURE_TOKEN=

# 影子降噪（W4-1.4）：默认开启——只标注"应收敛"不实际拦截，告警全量放行
# 去重/聚类时间窗（Go duration；默认 10m，非法值启动失败）
# OPS_NOISE_WINDOW=10m
# 设为 off 整体关闭（连影子判决都不产生，回到只计数行为）
# OPS_NOISE_SHADOW=on

# 双链路事件来源（W9/W11）
# 静态拓扑边（评估环境用；真实环境由云 API 发现）
# OPS_TOPOLOGY_EDGES=n1->n2,n2->n3
# 链路 A 自动建单开关：off（默认，影子期——消息只入队不建单）/ on
# OPS_INCIDENT_AUTOCREATE=off
# 链路 A 拉取侧：on 才启用（需同时设 OPS_PROM_URL，且需 OPS_DB_DSN 提供队列）
# OPS_PULL_ALERTS=off
# 拉取周期（Go duration；默认 30s）
# OPS_PULL_INTERVAL=30s

# Go 模块代理（国内环境必须，proxy.golang.org 不通）
GOPROXY=https://goproxy.cn,direct
